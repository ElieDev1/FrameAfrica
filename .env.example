# Frame Africa — Example environment variables
# Copy to `.env` (which is git-ignored) and fill in real values.
# NEVER commit a real .env. Only NEXT_PUBLIC_* values are exposed to the browser.

# ── App ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/v1

# ── Database (PostgreSQL) ───────────────────────────
# Port 5433, not the Postgres default 5432 — see docker-compose.yml (avoids
# clashing with a locally installed PostgreSQL service). Adjust if yours differs.
DATABASE_URL=postgresql://user:password@localhost:5433/frameafrica

# ── Cache / Queue (Redis) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── Search (OpenSearch/Elasticsearch) ───────────────
SEARCH_URL=http://localhost:9200

# ── Auth / JWT ──────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=1209600     # seconds (14 days)
EMAIL_VERIFICATION_TTL=86400  # seconds (24h) — email-verification link lifetime
PASSWORD_RESET_TTL=3600       # seconds (1h)  — password-reset link lifetime

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Object storage (S3-compatible) ──────────────────
S3_ENDPOINT=
S3_BUCKET=frameafrica-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=https://cdn.frameafrica.rw

# ── Payments (Rwanda) ───────────────────────────────
MOMO_API_KEY=
MOMO_API_SECRET=
AIRTEL_API_KEY=
AIRTEL_API_SECRET=
CARD_GATEWAY_KEY=

# ── Notifications ───────────────────────────────────
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMS_API_KEY=

# ── AI services ─────────────────────────────────────
AI_API_KEY=

# ── Public (safe to expose to the browser) ──────────
NEXT_PUBLIC_APP_NAME=Frame Africa
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_ANALYTICS_ID=
