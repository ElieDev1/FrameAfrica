# Prisma CLI loads .env from this directory (projects/api), not the repo root —
# copy this to `.env` here too (in addition to the root one) for `prisma migrate`
# / `prisma db seed` to pick up the right DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5433/frameafrica

# Required — the API refuses to start without it (no insecure default).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
