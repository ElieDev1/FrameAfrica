// Frame Africa — Prisma schema
// Base tables per documents/03-Database-Design.md. Starts with the entities
// needed for auth + first content flows; the rest of §3 follows in later PRs.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), citext]
}

enum UserStatus {
  active
  suspended
  deleted
}

enum RoleName {
  reader
  journalist
  sub_editor
  photographer
  editor
  moderator
  ads_manager
  admin
}

enum ArticleStatus {
  draft
  assigned
  in_progress
  copy_edit
  fact_check
  legal
  ready
  scheduled
  embargoed
  published
  correction_pending
  archived
  rejected
}

enum ArticleLanguage {
  en
  rw
  fr
  sw
}

model User {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email            String    @unique @db.Citext
  phone            String?   @unique
  passwordHash     String?   @map("password_hash")
  displayName      String    @map("display_name")
  avatarUrl        String?   @map("avatar_url")
  status           UserStatus @default(active)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  preferences      Json      @default("{}")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  roles    UserRole[]
  articles Article[]

  @@map("user")
}

model Role {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        RoleName   @unique
  permissions Json       @default("{}")

  users UserRole[]

  @@map("role")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

model Category {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryToChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToChildren")
  articles Article[]

  @@map("category")
}

model Article {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug         String        @unique
  title        String
  subtitle     String?
  body         String
  excerpt      String?
  authorId     String        @map("author_id") @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  status       ArticleStatus @default(draft)
  language     ArticleLanguage @default(en)
  isPremium    Boolean       @default(false) @map("is_premium")
  isBreaking   Boolean       @default(false) @map("is_breaking")
  readTimeMin  Int?          @map("read_time_min")
  viewCount    BigInt        @default(0) @map("view_count")
  likeCount    Int           @default(0) @map("like_count")
  shareCount   Int           @default(0) @map("share_count")
  seo          Json          @default("{}")
  publishedAt  DateTime?     @map("published_at")
  scheduledAt  DateTime?     @map("scheduled_at")
  embargoUntil DateTime?     @map("embargo_until")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  author   User     @relation(fields: [authorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([authorId])
  @@map("article")
}
