// Frame Africa — Prisma schema
// Base tables per documents/03-Database-Design.md. Starts with the entities
// needed for auth + first content flows; the rest of §3 follows in later PRs.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), citext]
}

enum UserStatus {
  active
  suspended
  deleted
}

enum RoleName {
  reader
  journalist
  sub_editor
  photographer
  editor
  moderator
  ads_manager
  admin
}

enum ArticleStatus {
  draft
  assigned
  in_progress
  copy_edit
  fact_check
  legal
  ready
  scheduled
  embargoed
  published
  correction_pending
  archived
  rejected
}

enum ArticleLanguage {
  en
  rw
  fr
  sw
}

enum UserTokenType {
  email_verification
  password_reset
}

enum CommentStatus {
  visible
  pending
  hidden
  removed
}

/// What a comment / like / share is attached to. Engagement is polymorphic so
/// every content type carries the same conversation and reaction surface —
/// there is no separate "media comments" system to moderate.
enum EngagementTarget {
  article
  gallery
  episode
  interactive
  video
}

enum NotificationType {
  article_published
  article_returned
  comment_reply
  inquiry_received
  tip_received
  subscriber_joined
  comment_reported
  account_locked
}

enum TipStatus {
  new
  reviewing
  actioned
  dismissed
}

enum AdPlacement {
  leaderboard
  billboard
  rectangle
  halfpage
  native
}

enum InquiryType {
  advertise
  contact
}

enum InquiryStatus {
  new
  in_progress
  closed
}

/// Publish state shared by standalone multimedia content types (galleries,
/// podcast episodes) — a simple draft → published toggle (documents/13 §4.3).
enum MediaStatus {
  draft
  published
}

/// A podcast episode can be audio or a video ("podcast can be video also").
enum PodcastMediaKind {
  audio
  video
}

/// Allow-listed embed providers for data visualisations / interactive graphics
/// (documents/13 §4.3). Only these hosts may be embedded, in a sandboxed iframe.
enum InteractiveProvider {
  datawrapper
  flourish
  infogram
  google
  youtube
}

model User {
  id                  String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email               String     @unique @db.Citext
  phone               String?    @unique
  passwordHash        String?    @map("password_hash")
  displayName         String     @map("display_name")
  avatarUrl           String?    @map("avatar_url")
  status              UserStatus @default(active)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  twoFactorEnabled    Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?    @map("two_factor_secret")
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  /// Brute-force lockout: consecutive failed sign-ins, and when the account was
  /// locked (non-null = locked; only an admin can clear it).
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedAt            DateTime?  @map("locked_at")
  commentsBannedAt    DateTime?  @map("comments_banned_at")
  /// Paid access through this instant; null/past = not a subscriber. Granted by
  /// an admin today; self-serve payments (MoMo/Airtel) land with billing.
  subscribedUntil     DateTime?  @map("subscribed_until")
  preferences         Json       @default("{}")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  roles          UserRole[]
  articles       Article[]
  refreshTokens  RefreshToken[]
  revisions      ArticleRevision[]   @relation("UserRevisions")
  tokens         UserToken[]
  comments       Comment[]
  mediaAssets    MediaAsset[]
  mediaAlbums    MediaAlbum[]        @relation("UserMediaAlbums")
  corrections    ArticleCorrection[] @relation("UserCorrections")
  likes          ContentLike[]
  liveUpdates    LiveUpdate[]        @relation("UserLiveUpdates")
  bookmarks      Bookmark[]
  commentLikes   CommentLike[]
  commentReports CommentReport[]
  follows        Follow[]
  readingHistory ReadingHistory[]
  notifications  Notification[]
  auditLogs      AuditLog[]          @relation("UserAuditLogs")
  galleries      Gallery[]
  subscriptions  Subscription[]
  payments       Payment[]

  @@map("user")
}

/// A reader's saved article (one per user per article). Surfaced in the reader's
/// account as "Saved" (documents/14 §2, FR-READ-5).
model Bookmark {
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, createdAt])
  @@map("bookmark")
}

/// A reader's follow of a section (category) or a topic. Exactly one of
/// `categoryId` / `topicId` is set (enforced in the service). Followed subjects
/// drive the account "Following" list and the personalised "For You" feed
/// (documents/14 §2, FR-READ-6).
model Follow {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  topicId    String?  @map("topic_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  topic    Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@unique([userId, topicId])
  @@index([userId, createdAt])
  @@map("follow")
}

/// An in-app notification for a user (documents/14 §6.3). Created by the system
/// on newsroom events (a story published / returned, a reply to a comment) and
/// surfaced in the dashboard bell. `readAt` marks it read.
model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

/// An audit-trail entry for a privileged action (documents/05 §11): who did
/// what, to which target, when. `actorId` is nullable for system actions and is
/// set null if the actor is later erased. Append-only.
model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

/// A reader's reading history: one row per user per article, `viewedAt` bumped
/// on each read. Powers the account "Recently read" list and the personalised
/// feed (documents/14 §2, FR-READ-6). Recorded only for signed-in readers.
model ReadingHistory {
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, viewedAt])
  @@map("reading_history")
}

/// A timestamped entry in a story's live/developing coverage (documents/14 §1,
/// FR-LIVE). Readers see these appear newest-first while the story is `isLive`.
model LiveUpdate {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  headline   String?
  body       String
  isKeyEvent Boolean  @default(false) @map("is_key_event")
  createdAt  DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation("UserLiveUpdates", fields: [authorId], references: [id])

  @@index([articleId, createdAt])
  @@map("live_update")
}

/// An uploaded media file in the library / DAM (documents/13 §5). The binary is
/// held by the storage driver (local dir in dev, S3 in prod); this row is the
/// catalogue entry with the required alt/credit/licence metadata (`06` §6).
/// An album groups the photos from one event/shoot so they can be found again
/// (documents/13 §5). Photographers own this, but any staffer may file into it.
/// Deleting an album never deletes its photos — they fall back to "Unfiled".
model MediaAlbum {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  /// When the event happened (may differ from when the photos were uploaded).
  eventDate   DateTime? @map("event_date")
  coverUrl    String?   @map("cover_url")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy User         @relation("UserMediaAlbums", fields: [createdById], references: [id])
  assets    MediaAsset[]

  @@index([createdAt])
  @@map("media_album")
}

model MediaAsset {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  uploaderId   String   @map("uploader_id") @db.Uuid
  /// Null = "Unfiled". Set null (not cascade) when an album is deleted.
  albumId      String?  @map("album_id") @db.Uuid
  url          String
  alt          String?
  credit       String?
  licence      String?
  mime         String
  sizeBytes    Int      @map("size_bytes")
  originalName String?  @map("original_name")
  createdAt    DateTime @default(now()) @map("created_at")

  uploader User        @relation(fields: [uploaderId], references: [id])
  album    MediaAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([uploaderId, createdAt])
  @@index([albumId, createdAt])
  @@map("media_asset")
}

/// Single-use, hashed, short-lived tokens for email verification and password
/// reset (documents/05-Security-Design.md §3.1). The raw token is emailed once
/// and never stored; only its SHA-256 hash lives here.
model UserToken {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_token")
}

/// One row per issued refresh token (hashed). `familyId` chains a rotation
/// lineage; presenting a rotated/unknown token revokes the whole family
/// (reuse detection). See documents/05-Security-Design.md §3.2.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

model Role {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        RoleName @unique
  permissions Json     @default("{}")

  users UserRole[]

  @@map("role")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

/// Admin-managed configuration (integration API keys, feature flags). Secret
/// values are stored here and only ever surfaced to admins masked; the raw
/// value is read server-side by the services that need it.
model AppSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(true) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_setting")
}

model Category {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  parent    Category?  @relation("CategoryToChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToChildren")
  articles  Article[]
  followers Follow[]

  @@map("category")
}

model Article {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug                String          @unique
  title               String
  subtitle            String?
  // Legacy plain-text body, kept for excerpt/search/read-time and as a fallback
  // renderer for pre-block articles. The structured document lives in `blocks`.
  body                String
  // The structured article document: an ordered list of typed blocks
  // (documents/13 §2). Validated + sanitised on write (block.sanitizer.ts).
  // Nullable while older rows carry only `body`.
  blocks              Json?
  excerpt             String?
  authorId            String          @map("author_id") @db.Uuid
  categoryId          String          @map("category_id") @db.Uuid
  status              ArticleStatus   @default(draft)
  language            ArticleLanguage @default(en)
  isPremium           Boolean         @default(false) @map("is_premium")
  isBreaking          Boolean         @default(false) @map("is_breaking")
  // Editor homepage curation: `isFeatured` pins a story to the front page;
  // `featuredAt` orders the featured set (newest pin first).
  isFeatured          Boolean         @default(false) @map("is_featured")
  featuredAt          DateTime?       @map("featured_at")
  // Live/developing coverage: when true the article shows a LIVE banner and its
  // real-time update feed (documents/14 §1).
  isLive              Boolean         @default(false) @map("is_live")
  readTimeMin         Int?            @map("read_time_min")
  // The editor's note when a submitted draft is returned (rejected). Shown to
  // the author so they know what to fix; cleared when they resubmit.
  reviewNote          String?         @map("review_note")
  // Featured image (documents/06 §6: images always carry alt + credit). A full
  // media-asset/DAM table + signed S3 upload lands later; this denormalised
  // featured image is the first media increment.
  featuredImageUrl    String?         @map("featured_image_url")
  featuredImageAlt    String?         @map("featured_image_alt")
  featuredImageCredit String?         @map("featured_image_credit")
  viewCount           BigInt          @default(0) @map("view_count")
  likeCount           Int             @default(0) @map("like_count")
  shareCount          Int             @default(0) @map("share_count")
  seo                 Json            @default("{}")
  publishedAt         DateTime?       @map("published_at")
  scheduledAt         DateTime?       @map("scheduled_at")
  embargoUntil        DateTime?       @map("embargo_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")

  author         User                @relation(fields: [authorId], references: [id])
  category       Category            @relation(fields: [categoryId], references: [id])
  revisions      ArticleRevision[]
  comments       Comment[]
  topics         ArticleTopic[]
  corrections    ArticleCorrection[]
  liveUpdates    LiveUpdate[]
  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]
  pageViews      PageView[]

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([authorId])
  @@map("article")
}

/// A single page view for analytics (documents/14 §8). Lightweight + anonymous:
/// no user link, just what was viewed, when, and the referrer host. Powers the
/// real-time editor dashboard ("reading now", top stories, referrers).
model PageView {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId    String?  @map("article_id") @db.Uuid
  path         String
  referrerHost String?  @map("referrer_host")
  createdAt    DateTime @default(now()) @map("created_at")

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([articleId, createdAt])
  @@map("page_view")
}

/// A followable subject (person, place, org, event) an article can be tagged
/// with — orthogonal to the section taxonomy (documents/14 §5.2). Topics have
/// their own pages and can be followed.
model Topic {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  articles  ArticleTopic[]
  followers Follow[]

  @@map("topic")
}

/// Article ↔ Topic tags (many-to-many).
model ArticleTopic {
  articleId String @map("article_id") @db.Uuid
  topicId   String @map("topic_id") @db.Uuid

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([articleId, topicId])
  @@index([topicId])
  @@map("article_topic")
}

/// Reader comments on an article (documents/04 §6). Threaded one level via
/// `parentId`; `status` drives moderation (visible/pending/hidden/removed).
model Comment {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// What this comment hangs off. `targetId` always points at the content row;
  /// `articleId` additionally keeps the FK (and its cascade) for articles, which
  /// are by far the most-commented type.
  targetType  EngagementTarget @default(article) @map("target_type")
  targetId    String           @map("target_id") @db.Uuid
  articleId   String?          @map("article_id") @db.Uuid
  authorId    String           @map("author_id") @db.Uuid
  parentId    String?          @map("parent_id") @db.Uuid
  body        String
  status      CommentStatus    @default(visible)
  likeCount   Int              @default(0) @map("like_count")
  reportCount Int              @default(0) @map("report_count")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  article Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id])
  parent  Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]       @relation("CommentReplies")
  likes   CommentLike[]
  reports CommentReport[]

  @@index([targetType, targetId, status, createdAt])
  @@index([articleId, status, createdAt])
  @@map("comment")
}

/// A like on any content type (replaces the article-only `article_like`).
model ContentLike {
  userId     String           @map("user_id") @db.Uuid
  targetType EngagementTarget @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("content_like")
}

/// A reader's like on a comment (one per user per comment). Denormalised
/// `comment.like_count` is kept in step.
model CommentLike {
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
  @@map("comment_like")
}

/// A reader flagging a comment for moderator review (one per user per comment).
model CommentReport {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  commentId  String   @map("comment_id") @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id])

  @@unique([commentId, reporterId])
  @@index([commentId])
  @@map("comment_report")
}

/// A public, dated correction or retraction note appended to a published
/// article (documents/01 FR-EDIT-5). Append-only — the log is never edited, so
/// the record of what changed and when is preserved (trust surface, `05` §13).
model ArticleCorrection {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  note      String
  editorId  String   @map("editor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation("UserCorrections", fields: [editorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_correction")
}

/// One metered article read, per reader per calendar month (documents/04 §7).
/// `readerKey` is an opaque per-device id (or `user:<id>` when signed in) — no
/// PII. Only written when the paywall meter is enabled.
model MeterRead {
  readerKey String   @map("reader_key")
  articleId String   @map("article_id") @db.Uuid
  period    String
  createdAt DateTime @default(now()) @map("created_at")

  @@id([readerKey, articleId, period])
  @@index([readerKey, period])
  @@map("meter_read")
}

/// A cached YouTube upload (documents/14 §3.1). Synced from the configured
/// channel's uploads playlist so the site never calls YouTube on a page render.
model Video {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  youtubeId    String   @unique @map("youtube_id")
  title        String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  // Editor curation: `isFeatured` pins a clip to the top of the hub / homepage
  // strip; `isHidden` keeps a synced clip out of the public hub without deleting
  // it (it can otherwise re-appear on the next sync).
  isFeatured   Boolean  @default(false) @map("is_featured")
  isHidden     Boolean  @default(false) @map("is_hidden")
  likeCount    Int      @default(0) @map("like_count")
  shareCount   Int      @default(0) @map("share_count")
  publishedAt  DateTime @map("published_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([publishedAt])
  @@map("video")
}

/// A standalone photo gallery / visual story (documents/13 §4.3, /galleries).
/// Photographers + editors build them from media-library images; the ordered
/// photos live in `images` as [{ url, alt, caption?, credit? }], validated on
/// write. A draft is invisible to readers until published.
model Gallery {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String      @unique
  title       String
  description String?
  coverUrl    String?     @map("cover_url")
  coverAlt    String?     @map("cover_alt")
  images      Json        @default("[]")
  status      MediaStatus @default(draft)
  authorId    String      @map("author_id") @db.Uuid
  viewCount   BigInt      @default(0) @map("view_count")
  likeCount   Int         @default(0) @map("like_count")
  shareCount  Int         @default(0) @map("share_count")
  publishedAt DateTime?   @map("published_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@map("gallery")
}

/// A podcast show / series (documents/13 §4.3, /podcasts). Groups episodes and
/// carries the external subscribe links (RSS/Spotify/Apple).
model PodcastShow {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String      @unique
  title       String
  description String?
  coverUrl    String?     @map("cover_url")
  spotifyUrl  String?     @map("spotify_url")
  appleUrl    String?     @map("apple_url")
  rssUrl      String?     @map("rss_url")
  status      MediaStatus @default(draft)
  createdById String      @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  episodes PodcastEpisode[]

  @@index([status])
  @@map("podcast_show")
}

/// A single episode. `mediaKind` is audio or video; `mediaUrl` is either an
/// uploaded file (/uploads/…), an external audio URL, or a video URL (YouTube /
/// uploaded mp4 / embed). Draft until published.
model PodcastEpisode {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  showId      String           @map("show_id") @db.Uuid
  slug        String           @unique
  title       String
  description String?
  mediaKind   PodcastMediaKind @default(audio) @map("media_kind")
  mediaUrl    String           @map("media_url")
  coverUrl    String?          @map("cover_url")
  durationSec Int?             @map("duration_sec")
  episodeNo   Int?             @map("episode_no")
  status      MediaStatus      @default(draft)
  likeCount   Int              @default(0) @map("like_count")
  shareCount  Int              @default(0) @map("share_count")
  publishedAt DateTime?        @map("published_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  show PodcastShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId, publishedAt])
  @@map("podcast_episode")
}

/// A data visualisation / interactive graphic (documents/13 §4.3, /interactives).
/// `embedUrl` is validated against an allow-list of `provider` hosts on write and
/// rendered in a sandboxed iframe.
model Interactive {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String              @unique
  title       String
  description String?
  provider    InteractiveProvider
  embedUrl    String              @map("embed_url")
  coverUrl    String?             @map("cover_url")
  aspectRatio String              @default("16/9") @map("aspect_ratio")
  source      String?
  status      MediaStatus         @default(draft)
  authorId    String              @map("author_id") @db.Uuid
  likeCount   Int                 @default(0) @map("like_count")
  shareCount  Int                 @default(0) @map("share_count")
  publishedAt DateTime?           @map("published_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  @@index([status, publishedAt])
  @@map("interactive")
}

/// A house advertisement (documents/14 §4). Managed by admins and served into
/// labelled ad slots until a full ad-sales server lands. Impressions/clicks are
/// counted for basic reporting.
model HouseAd {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  imageUrl    String?     @map("image_url")
  linkUrl     String      @map("link_url")
  placement   AdPlacement
  isActive    Boolean     @default(true) @map("is_active")
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([placement, isActive])
  @@map("house_ad")
}

/// A newsletter subscriber (documents/14 §6). Single opt-in for now
/// (`confirmedAt` set on subscribe); `unsubscribeToken` powers one-click
/// unsubscribe. Resubscribing clears `unsubscribedAt`.
model NewsletterSubscriber {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email            String    @unique @db.Citext
  confirmedAt      DateTime? @map("confirmed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  unsubscribeToken String    @unique @map("unsubscribe_token")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("newsletter_subscriber")
}

/// A confidential news tip from the public (documents/14 §7 secure tips). No
/// author link — tips are anonymous unless the tipster volunteers `contact`.
/// Message + contact are stripped of markup on write.
model Tip {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  message   String
  contact   String?
  status    TipStatus @default(new)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("tip")
}

/// A public inquiry from a footer form — an advertiser ("advertise") or a
/// general "contact" message. Admins see and work on these (status pipeline).
/// All text is stripped of markup on write.
model Inquiry {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type      InquiryType
  name      String
  email     String
  company   String?
  subject   String?
  message   String
  budget    String?
  placement String?
  status    InquiryStatus @default(new)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([type, status, createdAt])
  @@map("inquiry")
}

/// A newsletter campaign composed + sent by an editor/admin. Actual delivery to
/// subscribers lands with an SMTP/queue worker; this records the campaign and a
/// recipient snapshot for the audit trail.
model NewsletterCampaign {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subject    String
  body       String
  recipients Int       @default(0)
  sentAt     DateTime? @map("sent_at")
  senderId   String?   @map("sender_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("newsletter_campaign")
}

/// Immutable snapshot captured on every draft save (documents/03 §3.5).
model ArticleRevision {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  editorId   String   @map("editor_id") @db.Uuid
  title      String
  body       String
  changeNote String?  @map("change_note")
  createdAt  DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation("UserRevisions", fields: [editorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_revision")
}

// ─── Billing ──────────────────────────────────────────────────────────────────
// The paywall gates premium stories on `User.subscribedUntil`. These models are
// what actually *sets* it: a reader picks a Plan, pays through a provider, and a
// succeeded Payment activates a Subscription which extends `subscribedUntil`
// (documents/01 FR-SUB-1..3, documents/05 §8).

enum PlanInterval {
  month
  year
}

enum SubscriptionStatus {
  /// Awaiting first successful payment.
  incomplete
  active
  /// Payment failed but access hasn't lapsed yet — retry window.
  past_due
  canceled
  expired
}

enum PaymentProvider {
  stripe
  momo
  airtel
  /// Granted by an admin (comped, corporate, cash) — no gateway involved.
  manual
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

/// A subscription offer. Prices are held in minor units (RWF has none, so cents
/// == francs) to avoid floating-point money.
model Plan {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  priceCents  Int          @map("price_cents")
  currency    String       @default("RWF")
  interval    PlanInterval
  /// Free trial length, in days; 0 = none.
  trialDays   Int          @default(0) @map("trial_days")
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plan")
}

/// A reader's paid access to a plan. The active one is what keeps
/// `User.subscribedUntil` in the future.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(incomplete)
  provider           PaymentProvider
  /// The gateway's own id for this subscription (Stripe sub id, MoMo ref…).
  providerRef        String?            @map("provider_ref")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscription")
}

/// One attempt to take money. `providerRef` is unique so a webhook replay can't
/// double-credit a reader (documents/05 §8 — idempotent webhooks).
model Payment {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  subscriptionId String?         @map("subscription_id") @db.Uuid
  amountCents    Int             @map("amount_cents")
  currency       String          @default("RWF")
  provider       PaymentProvider
  providerRef    String?         @unique @map("provider_ref")
  status         PaymentStatus   @default(pending)
  failureReason  String?         @map("failure_reason")
  paidAt         DateTime?       @map("paid_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("payment")
}
