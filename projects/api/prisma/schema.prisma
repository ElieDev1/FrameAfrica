// Frame Africa — Prisma schema
// Base tables per documents/03-Database-Design.md. Starts with the entities
// needed for auth + first content flows; the rest of §3 follows in later PRs.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), citext]
}

enum UserStatus {
  active
  suspended
  deleted
}

enum RoleName {
  reader
  journalist
  sub_editor
  photographer
  editor
  moderator
  ads_manager
  admin
}

enum ArticleStatus {
  draft
  assigned
  in_progress
  copy_edit
  fact_check
  legal
  ready
  scheduled
  embargoed
  published
  correction_pending
  archived
  rejected
}

enum ArticleLanguage {
  en
  rw
  fr
  sw
}

enum UserTokenType {
  email_verification
  password_reset
}

enum CommentStatus {
  visible
  pending
  hidden
  removed
}

enum NotificationType {
  article_published
  article_returned
  comment_reply
}

model User {
  id                 String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email              String     @unique @db.Citext
  phone              String?    @unique
  passwordHash       String?    @map("password_hash")
  displayName        String     @map("display_name")
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(active)
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  twoFactorEnabled   Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret    String?    @map("two_factor_secret")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  commentsBannedAt   DateTime?  @map("comments_banned_at")
  preferences        Json       @default("{}")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  roles          UserRole[]
  articles       Article[]
  refreshTokens  RefreshToken[]
  revisions      ArticleRevision[]   @relation("UserRevisions")
  tokens         UserToken[]
  comments       Comment[]
  mediaAssets    MediaAsset[]
  corrections    ArticleCorrection[] @relation("UserCorrections")
  likes          ArticleLike[]
  liveUpdates    LiveUpdate[]        @relation("UserLiveUpdates")
  bookmarks      Bookmark[]
  commentLikes   CommentLike[]
  commentReports CommentReport[]
  follows        Follow[]
  readingHistory ReadingHistory[]
  notifications  Notification[]
  auditLogs      AuditLog[]          @relation("UserAuditLogs")

  @@map("user")
}

/// A reader's saved article (one per user per article). Surfaced in the reader's
/// account as "Saved" (documents/14 §2, FR-READ-5).
model Bookmark {
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, createdAt])
  @@map("bookmark")
}

/// A reader's follow of a section (category) or a topic. Exactly one of
/// `categoryId` / `topicId` is set (enforced in the service). Followed subjects
/// drive the account "Following" list and the personalised "For You" feed
/// (documents/14 §2, FR-READ-6).
model Follow {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  topicId    String?  @map("topic_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  topic    Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@unique([userId, topicId])
  @@index([userId, createdAt])
  @@map("follow")
}

/// An in-app notification for a user (documents/14 §6.3). Created by the system
/// on newsroom events (a story published / returned, a reply to a comment) and
/// surfaced in the dashboard bell. `readAt` marks it read.
model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

/// An audit-trail entry for a privileged action (documents/05 §11): who did
/// what, to which target, when. `actorId` is nullable for system actions and is
/// set null if the actor is later erased. Append-only.
model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

/// A reader's reading history: one row per user per article, `viewedAt` bumped
/// on each read. Powers the account "Recently read" list and the personalised
/// feed (documents/14 §2, FR-READ-6). Recorded only for signed-in readers.
model ReadingHistory {
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, viewedAt])
  @@map("reading_history")
}

/// A timestamped entry in a story's live/developing coverage (documents/14 §1,
/// FR-LIVE). Readers see these appear newest-first while the story is `isLive`.
model LiveUpdate {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  headline   String?
  body       String
  isKeyEvent Boolean  @default(false) @map("is_key_event")
  createdAt  DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation("UserLiveUpdates", fields: [authorId], references: [id])

  @@index([articleId, createdAt])
  @@map("live_update")
}

/// A reader's like on an article (one per user per article). The denormalised
/// `article.like_count` is kept in step on like/unlike.
model ArticleLike {
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
  @@map("article_like")
}

/// An uploaded media file in the library / DAM (documents/13 §5). The binary is
/// held by the storage driver (local dir in dev, S3 in prod); this row is the
/// catalogue entry with the required alt/credit/licence metadata (`06` §6).
model MediaAsset {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  uploaderId   String   @map("uploader_id") @db.Uuid
  url          String
  alt          String?
  credit       String?
  licence      String?
  mime         String
  sizeBytes    Int      @map("size_bytes")
  originalName String?  @map("original_name")
  createdAt    DateTime @default(now()) @map("created_at")

  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([uploaderId, createdAt])
  @@map("media_asset")
}

/// Single-use, hashed, short-lived tokens for email verification and password
/// reset (documents/05-Security-Design.md §3.1). The raw token is emailed once
/// and never stored; only its SHA-256 hash lives here.
model UserToken {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_token")
}

/// One row per issued refresh token (hashed). `familyId` chains a rotation
/// lineage; presenting a rotated/unknown token revokes the whole family
/// (reuse detection). See documents/05-Security-Design.md §3.2.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

model Role {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        RoleName @unique
  permissions Json     @default("{}")

  users UserRole[]

  @@map("role")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

/// Admin-managed configuration (integration API keys, feature flags). Secret
/// values are stored here and only ever surfaced to admins masked; the raw
/// value is read server-side by the services that need it.
model AppSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(true) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_setting")
}

model Category {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  parent    Category?  @relation("CategoryToChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToChildren")
  articles  Article[]
  followers Follow[]

  @@map("category")
}

model Article {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug                String          @unique
  title               String
  subtitle            String?
  // Legacy plain-text body, kept for excerpt/search/read-time and as a fallback
  // renderer for pre-block articles. The structured document lives in `blocks`.
  body                String
  // The structured article document: an ordered list of typed blocks
  // (documents/13 §2). Validated + sanitised on write (block.sanitizer.ts).
  // Nullable while older rows carry only `body`.
  blocks              Json?
  excerpt             String?
  authorId            String          @map("author_id") @db.Uuid
  categoryId          String          @map("category_id") @db.Uuid
  status              ArticleStatus   @default(draft)
  language            ArticleLanguage @default(en)
  isPremium           Boolean         @default(false) @map("is_premium")
  isBreaking          Boolean         @default(false) @map("is_breaking")
  // Editor homepage curation: `isFeatured` pins a story to the front page;
  // `featuredAt` orders the featured set (newest pin first).
  isFeatured          Boolean         @default(false) @map("is_featured")
  featuredAt          DateTime?       @map("featured_at")
  // Live/developing coverage: when true the article shows a LIVE banner and its
  // real-time update feed (documents/14 §1).
  isLive              Boolean         @default(false) @map("is_live")
  readTimeMin         Int?            @map("read_time_min")
  // The editor's note when a submitted draft is returned (rejected). Shown to
  // the author so they know what to fix; cleared when they resubmit.
  reviewNote          String?         @map("review_note")
  // Featured image (documents/06 §6: images always carry alt + credit). A full
  // media-asset/DAM table + signed S3 upload lands later; this denormalised
  // featured image is the first media increment.
  featuredImageUrl    String?         @map("featured_image_url")
  featuredImageAlt    String?         @map("featured_image_alt")
  featuredImageCredit String?         @map("featured_image_credit")
  viewCount           BigInt          @default(0) @map("view_count")
  likeCount           Int             @default(0) @map("like_count")
  shareCount          Int             @default(0) @map("share_count")
  seo                 Json            @default("{}")
  publishedAt         DateTime?       @map("published_at")
  scheduledAt         DateTime?       @map("scheduled_at")
  embargoUntil        DateTime?       @map("embargo_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")

  author         User                @relation(fields: [authorId], references: [id])
  category       Category            @relation(fields: [categoryId], references: [id])
  revisions      ArticleRevision[]
  comments       Comment[]
  topics         ArticleTopic[]
  corrections    ArticleCorrection[]
  likes          ArticleLike[]
  liveUpdates    LiveUpdate[]
  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([authorId])
  @@map("article")
}

/// A followable subject (person, place, org, event) an article can be tagged
/// with — orthogonal to the section taxonomy (documents/14 §5.2). Topics have
/// their own pages and can be followed.
model Topic {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  articles  ArticleTopic[]
  followers Follow[]

  @@map("topic")
}

/// Article ↔ Topic tags (many-to-many).
model ArticleTopic {
  articleId String @map("article_id") @db.Uuid
  topicId   String @map("topic_id") @db.Uuid

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([articleId, topicId])
  @@index([topicId])
  @@map("article_topic")
}

/// Reader comments on an article (documents/04 §6). Threaded one level via
/// `parentId`; `status` drives moderation (visible/pending/hidden/removed).
model Comment {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId   String        @map("article_id") @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  body        String
  status      CommentStatus @default(visible)
  likeCount   Int           @default(0) @map("like_count")
  reportCount Int           @default(0) @map("report_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  article Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id])
  parent  Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]       @relation("CommentReplies")
  likes   CommentLike[]
  reports CommentReport[]

  @@index([articleId, status, createdAt])
  @@map("comment")
}

/// A reader's like on a comment (one per user per comment). Denormalised
/// `comment.like_count` is kept in step.
model CommentLike {
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
  @@map("comment_like")
}

/// A reader flagging a comment for moderator review (one per user per comment).
model CommentReport {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  commentId  String   @map("comment_id") @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id])

  @@unique([commentId, reporterId])
  @@index([commentId])
  @@map("comment_report")
}

/// A public, dated correction or retraction note appended to a published
/// article (documents/01 FR-EDIT-5). Append-only — the log is never edited, so
/// the record of what changed and when is preserved (trust surface, `05` §13).
model ArticleCorrection {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  note      String
  editorId  String   @map("editor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation("UserCorrections", fields: [editorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_correction")
}

/// Immutable snapshot captured on every draft save (documents/03 §3.5).
model ArticleRevision {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  editorId   String   @map("editor_id") @db.Uuid
  title      String
  body       String
  changeNote String?  @map("change_note")
  createdAt  DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation("UserRevisions", fields: [editorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_revision")
}
