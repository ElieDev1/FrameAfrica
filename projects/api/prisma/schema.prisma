// Frame Africa — Prisma schema
// Base tables per documents/03-Database-Design.md. Starts with the entities
// needed for auth + first content flows; the rest of §3 follows in later PRs.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), citext]
}

enum UserStatus {
  active
  suspended
  deleted
}

enum RoleName {
  reader
  journalist
  sub_editor
  photographer
  editor
  moderator
  ads_manager
  admin
}

enum ArticleStatus {
  draft
  assigned
  in_progress
  copy_edit
  fact_check
  legal
  ready
  scheduled
  embargoed
  published
  correction_pending
  archived
  rejected
}

enum ArticleLanguage {
  en
  rw
  fr
  sw
}

enum UserTokenType {
  email_verification
  password_reset
}

enum CommentStatus {
  visible
  pending
  hidden
  removed
}

model User {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email            String    @unique @db.Citext
  phone            String?   @unique
  passwordHash     String?   @map("password_hash")
  displayName      String    @map("display_name")
  avatarUrl        String?   @map("avatar_url")
  status           UserStatus @default(active)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  preferences      Json      @default("{}")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  roles         UserRole[]
  articles      Article[]
  refreshTokens RefreshToken[]
  revisions     ArticleRevision[] @relation("UserRevisions")
  tokens        UserToken[]
  comments      Comment[]
  mediaAssets   MediaAsset[]

  @@map("user")
}

/// An uploaded media file in the library / DAM (documents/13 §5). The binary is
/// held by the storage driver (local dir in dev, S3 in prod); this row is the
/// catalogue entry with the required alt/credit/licence metadata (`06` §6).
model MediaAsset {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  uploaderId   String   @map("uploader_id") @db.Uuid
  url          String
  alt          String?
  credit       String?
  licence      String?
  mime         String
  sizeBytes    Int      @map("size_bytes")
  originalName String?  @map("original_name")
  createdAt    DateTime @default(now()) @map("created_at")

  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([uploaderId, createdAt])
  @@map("media_asset")
}

/// Single-use, hashed, short-lived tokens for email verification and password
/// reset (documents/05-Security-Design.md §3.1). The raw token is emailed once
/// and never stored; only its SHA-256 hash lives here.
model UserToken {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_token")
}

/// One row per issued refresh token (hashed). `familyId` chains a rotation
/// lineage; presenting a rotated/unknown token revokes the whole family
/// (reuse detection). See documents/05-Security-Design.md §3.2.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

model Role {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        RoleName   @unique
  permissions Json       @default("{}")

  users UserRole[]

  @@map("role")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

model Category {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryToChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToChildren")
  articles Article[]

  @@map("category")
}

model Article {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug         String        @unique
  title        String
  subtitle     String?
  // Legacy plain-text body, kept for excerpt/search/read-time and as a fallback
  // renderer for pre-block articles. The structured document lives in `blocks`.
  body         String
  // The structured article document: an ordered list of typed blocks
  // (documents/13 §2). Validated + sanitised on write (block.sanitizer.ts).
  // Nullable while older rows carry only `body`.
  blocks       Json?
  excerpt      String?
  authorId     String        @map("author_id") @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  status       ArticleStatus @default(draft)
  language     ArticleLanguage @default(en)
  isPremium    Boolean       @default(false) @map("is_premium")
  isBreaking   Boolean       @default(false) @map("is_breaking")
  readTimeMin  Int?          @map("read_time_min")
  // Featured image (documents/06 §6: images always carry alt + credit). A full
  // media-asset/DAM table + signed S3 upload lands later; this denormalised
  // featured image is the first media increment.
  featuredImageUrl    String? @map("featured_image_url")
  featuredImageAlt    String? @map("featured_image_alt")
  featuredImageCredit String? @map("featured_image_credit")
  viewCount    BigInt        @default(0) @map("view_count")
  likeCount    Int           @default(0) @map("like_count")
  shareCount   Int           @default(0) @map("share_count")
  seo          Json          @default("{}")
  publishedAt  DateTime?     @map("published_at")
  scheduledAt  DateTime?     @map("scheduled_at")
  embargoUntil DateTime?     @map("embargo_until")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  author      User                @relation(fields: [authorId], references: [id])
  category    Category            @relation(fields: [categoryId], references: [id])
  revisions   ArticleRevision[]
  comments    Comment[]
  topics      ArticleTopic[]
  corrections ArticleCorrection[]

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([authorId])
  @@map("article")
}

/// A followable subject (person, place, org, event) an article can be tagged
/// with — orthogonal to the section taxonomy (documents/14 §5.2). Topics have
/// their own pages and can be followed.
model Topic {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  articles ArticleTopic[]

  @@map("topic")
}

/// Article ↔ Topic tags (many-to-many).
model ArticleTopic {
  articleId String @map("article_id") @db.Uuid
  topicId   String @map("topic_id") @db.Uuid

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([articleId, topicId])
  @@index([topicId])
  @@map("article_topic")
}

/// Reader comments on an article (documents/04 §6). Threaded one level via
/// `parentId`; `status` drives moderation (visible/pending/hidden/removed).
model Comment {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId String        @map("article_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  body      String
  status    CommentStatus @default(visible)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([articleId, status, createdAt])
  @@map("comment")
}

/// A public, dated correction or retraction note appended to a published
/// article (documents/01 FR-EDIT-5). Append-only — the log is never edited, so
/// the record of what changed and when is preserved (trust surface, `05` §13).
model ArticleCorrection {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  note      String
  editorId  String   @map("editor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation("UserCorrections", fields: [editorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_correction")
}

/// Immutable snapshot captured on every draft save (documents/03 §3.5).
model ArticleRevision {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  editorId   String   @map("editor_id") @db.Uuid
  title      String
  body       String
  changeNote String?  @map("change_note")
  createdAt  DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation("UserRevisions", fields: [editorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_revision")
}
