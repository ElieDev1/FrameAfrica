# Frame Africa — line-ending normalization
# Keep the repository LF-normalized so tooling (Prettier, ESLint) behaves
# identically across Windows, macOS, Linux, and CI.

# Default: normalize text files to LF in the repo, auto-detect on checkout.
* text=auto eol=lf

# Explicit LF for source, config, and docs.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf

# Binary assets — never normalize or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
